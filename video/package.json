{
  "name": "@picklescout/video",
  "private": true,
  "version": "0.0.0",
  "description": "PickleScout 30-second product intro video (Remotion)",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "render": "python3 scripts/make-music.py && remotion render src/index.ts PickleScoutIntro out/picklescout-intro.mp4",
    "music": "python3 scripts/make-music.py",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/cli": "4.0.529",
    "@remotion/google-fonts": "4.0.529",
    "@remotion/transitions": "4.0.529",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.529"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "typescript": "5.9.3"
  }
}
